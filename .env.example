POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://assurgrid:assurgrid_local@localhost:5432/assurgrid?connect_timeout=3
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development
