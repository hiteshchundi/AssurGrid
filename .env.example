# Local development only. Keep these values consistent with DATABASE_URL.
POSTGRES_USER=assurgrid
POSTGRES_PASSWORD=assurgrid_local
POSTGRES_DB=assurgrid
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://assurgrid:assurgrid_local@localhost:5432/assurgrid?connect_timeout=3
FRONTEND_ORIGIN=http://localhost:5173
APP_ENV=development
# Development-only password login organization. Registry reads require a session.
# DEMO_REGISTRY_ORGANIZATION_ID=
# Explicit synthetic sandbox only. Keep disabled for ordinary local password login.
PUBLIC_DEMO_ENABLED=false
